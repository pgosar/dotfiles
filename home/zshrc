#!/usr/bin/env zsh
# shellcheck disable=SC1071,SC1090,SC1091,SC2094,SC2102,SC2193,SC2203
#   ________         ______         __    __
#  |        \       /      \       |  \  |  \
#   \$$$$$$$$      |  $$$$$$\      | $$  | $$
#      /  $$       | $$___\$$      | $$__| $$
#     /  $$         \$$    \       | $$    $$
#    /  $$          _\$$$$$$\      | $$$$$$$$
#   /  $$___       |  \__| $$      | $$  | $$
#  |  $$    \       \$$    $$      | $$  | $$
#   \$$$$$$$$        \$$$$$$        \$$   \$$
#

OS="$(uname)"

if [ -z "${LANG:-}" ] || [ "${LANG:-}" = "POSIX" ]; then
  export LANG=C.utf8
fi

# ---- Environment Variables -------------------------------------------------

export PATH="$HOME/.config/dotfiles-scripts:$HOME/.local/bin:$HOME/.local/share/nvim/mason/bin:$HOME/.cargo/bin:$HOME/go/bin:$HOME/.spicetify:$PATH"

export ZSH="$HOME/.oh-my-zsh"
export DOTFILES_DIR="${DOTFILES_DIR:-${${(%):-%x}:A:h:h}}"
export EDITOR='nvim'
export VISUAL='nvim'

if [ "$OS" = "Linux" ]; then
  export QML_XHR_ALLOW_FILE_READ=1
fi

# Theme-generated eza colors
[ -f "$HOME/.config/shell/eza-colors.sh" ] && source "$HOME/.config/shell/eza-colors.sh"
# Do not inherit an old Vivid palette from the desktop session.
unset LS_COLORS
# Eza owns listing colors; prevent Oh My Zsh from creating a default LS_COLORS.
export DISABLE_LS_COLORS=true

if [ "$OS" = "Darwin" ]; then
  export HOMEBREW_NO_AUTO_UPDATE=1
  export HOMEBREW_NO_ENV_HINTS=1
  # allow use of gnu tools
  export PATH="/opt/homebrew/opt/gnu-sed/libexec/gnubin:$PATH"
fi

# ---- Terminal Settings -----------------------------------------------------

export DISABLE_MAGIC_FUNCTIONS="true"
export COMPLETION_WAITING_DOTS="true" # show command is auto completing
export HISTSIZE=10000                 # big history
export SAVEHIST=10000
export DISABLE_UNTRACKED_FILES_DIRTY="true" # stops git status from checking untracked files

autoload -U edit-command-line # edit command in vim
autoload -U bashcompinit
bashcompinit
zle -N edit-command-line

# disable ctrl-s and q
if [[ -n ${TTY:-} && $+commands[stty] == 1 ]]; then
  stty -ixon <"$TTY" >"$TTY"
fi

set -o ignoreeof
unalias -a # remove preset aliases

# ---- Plugins ---------------------------------------------------------------

plugins=(
  git
  pip
  copyfile
  command-not-found
  colored-man-pages
  last-working-dir
  safe-paste
  zsh-interactive-cd
  zsh-autosuggestions
  vi-mode
)

# ---- Load Scripts ----------------------------------------------------------

if [ "$OS" = "Darwin" ] && command -v brew >/dev/null 2>&1; then
  FPATH="$(brew --prefix)/share/zsh/site-functions:${FPATH}"
fi

source "$ZSH"/oh-my-zsh.sh >/dev/null 2>&1 # load oh-my-zsh

loadpath="$DOTFILES_DIR/home/scripts"
if [ -f "$loadpath/aliasList.sh" ]; then # load aliases
  # shellcheck source=/dev/null
  source "$loadpath/aliasList.sh"
fi
if [ -f "$loadpath/commands.sh" ]; then # load commands
  # shellcheck source=/dev/null
  source "$loadpath/commands.sh"
fi

# ---- Keybindings -----------------------------------------------------------

bindkey '^d' autosuggest-accept
bindkey '^k' edit-command-line

# ---- Cross-Platform Tool Setup ---------------------------------------------

if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

if command -v register-python-argcomplete >/dev/null 2>&1; then
  eval "$(register-python-argcomplete pipx)"
fi

# shellcheck disable=SC1090
if command -v fzf >/dev/null 2>&1; then
  # fzf changes the zle option on load, which errors without a
  # terminal; its keybindings need one anyway
  if [[ -t 0 ]]; then
    source <(fzf --zsh)
  fi
fi

# Miniconda
if [ -f /opt/miniconda3/etc/profile.d/conda.sh ]; then
  # shellcheck source=/dev/null
  source /opt/miniconda3/etc/profile.d/conda.sh
elif [ -f "$HOME/miniconda3/etc/profile.d/conda.sh" ]; then
  # shellcheck source=/dev/null
  source "$HOME/miniconda3/etc/profile.d/conda.sh"
fi

# fnm (Fast Node Manager) -- replaces nvm, near-instant startup
if command -v fnm >/dev/null 2>&1; then
  eval "$(fnm env --use-on-cd)"
fi

# ---- OS-Specific Commands --------------------------------------------------

if [ "$OS" = "Darwin" ]; then
  ulimit -Sn unlimited && ulimit -Sl unlimited
fi

ZSH_SYNTAX_HIGHLIGHTING="${ZSH_CUSTOM:-$ZSH/custom}/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
if [ -f "$ZSH_SYNTAX_HIGHLIGHTING" ]; then
  # shellcheck source=/dev/null
  source "$ZSH_SYNTAX_HIGHLIGHTING"
fi

# Neovim 0.12 terminal queries can time out across SSH.
# Disable the fast-terminal assumption before Neovim starts (config is too late).
if [[ -n "${SSH_CONNECTION:-}" ]]; then
  export NVIM_NOTTYFAST=1
fi
