[user]
	name = pgosar
	email = pgosarsteam@gmail.com
[core]
  # default editor
  editor = 'nvim'
	# trailing whitespace doesn't cause merge conflicts
  whitespace = -trailing-space

[diff]
  external = difft
  # Show renames/moves
  renames = true
  # show submodule-related information
  submodule = log

[difftool]
  prompt = false

[difftool "difftastic"]
  cmd = difft "$LOCAL" "$REMOTE"

[pager]
  difftool = true
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[grep]
  break = true
  heading = true
  lineNumber = true
[log]
  # Use abbrev SHAs
  abbrevCommit = true
  # Automatically --follow when given a single path
  follow = true
  # Disable decorate for reflog
  decorate = false
[merge]
  conflictStyle = zdiff3
[mergetool]
  # Clean up backup files
  keepBackup = false
  # Clean up temp files
  keepTemporaries = false
  # Put the temp files in a dedicated dir
  writeToTemp = true
  # Auto-accept file prompts when launching merge tools
  prompt = false
[fetch]
  # Auto-fetch submodule changes
  recurseSubmodules = on-demand
[push]
	# only pushes current branch to target regardless of remote name
	default = upstream
	# push tags too
	followTags = true
	autoSetupRemote = true
[status]
  # Display submodule rev change summaries in status
  submoduleSummary = true
  # recursively shows all untracked files
  showUntrackedFiles = all
[color "branch"]
  # change color to cyan
  upstream = cyan
[tag]
  # Sort tags as version numbers
  sort = version:refname
[alias]
  edit = !$EDITOR $(git status --short | awk '$1 ~ /^M|A|U/ {print $2}')

[init]
	defaultBranch = main
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
