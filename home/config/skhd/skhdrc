# switch window positions
shift + alt - h : yabai -m window --warp west
shift + alt - j : yabai -m window --warp south
shift + alt - k : yabai -m window --warp north
shift + alt - l : yabai -m window --warp east

# switch focus between windows
cmd + alt - h : yabai -m window --focus west
cmd + alt - j : yabai -m window --focus south
cmd + alt - k : yabai -m window --focus north
cmd + alt - l : yabai -m window --focus east

# move  window to different space
alt - 1 : yabai -m window --space 1
alt - 2 : yabai -m window --space 2
alt - 3 : yabai -m window --space 3
alt - 4 : yabai -m window --space 4
alt - 5 : yabai -m window --space 5
alt - 6 : yabai -m window --space 6
alt - 7 : yabai -m window --space 7
alt - 8 : yabai -m window --space 8
alt - 9 : yabai -m window --space 9

# switch focus to different space
# NOTE: yabai -m space --focus needs the scripting addition, which does not
# load on macOS 26 (Tahoe). Focusing a space's first window pulls macOS to
# that space instead. No-op on empty spaces.
cmd - 1 : wid=$(/opt/homebrew/bin/yabai -m query --windows --space 1 | /opt/homebrew/bin/jq -r '.[0].id // empty'); [ -n "$wid" ] && /opt/homebrew/bin/yabai -m window --focus $wid
