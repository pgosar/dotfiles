#!/usr/bin/env sh

# Do not stall startup when the scripting-addition sudoers rule has not been
# installed yet.  With it installed, this loads automatically on login/Dock restart.
sudo -n yabai --load-sa 2>/dev/null || true
yabai -m signal --add event=dock_did_restart action="sudo -n yabai --load-sa 2>/dev/null || true"

# auto float non-resizable windows
yabai -m signal --add event=window_created action='
  yabai -m query --windows --window $yabai_window_id | jq -er ".\"can-resize\" or .\"is-floating\"" || \
 yabai -m window $yabai_window_id --toggle float --grid 4:4:1:1:2:2
'

# Float everything by default -- only Firefox and kitty are tiled.
# All windows on the below sub-layer: yabai v7 pins floating windows above
# tiled ones otherwise; same-layer windows stack by focus.
yabai -m rule --add label="float-all" app=".*" manage=off sub-layer=below
yabai -m rule --add label="tile-firefox" app="^Firefox$" manage=on sub-layer=below
yabai -m rule --add label="tile-kitty" app="^kitty$" manage=on sub-layer=below
yabai -m rule --apply

yabai -m config external_bar all:40:0 \
	mouse_follows_focus on \
	focus_follows_mouse off \
	window_zoom_persist off \
	window_placement second_child \
	window_shadow float \
	window_opacity off \
	window_opacity_duration 0.2 \
	active_window_opacity 1.0 \
	insert_feedback_color 0xff9dd274 \
	split_ratio 0.50 \
	auto_balance off \
	mouse_modifier fn \
	mouse_action1 move \
	mouse_action2 resize \
	mouse_drop_action swap \
	\
	top_padding 0 \
	bottom_padding 8 \
	left_padding 8 \
	right_padding 8 \
	window_gap 8

yabai -m config layout bsp
borders active_color=0xffe1e3e4 inactive_color=0xff494d64 width=5.0 &

echo "yabai configuration loaded.."
